{
  "manifest_version": 3,
  "name": "Tab Rename",
  "version": "2.3.0",
  "description": "Rename tabs with ease - clean, minimal, intuitive",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "MacCtrl+R"
      }
    }
  }
}
